{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "adk web",
            "type": "debugpy",
            "request": "launch",
            "module": "google.adk.cli",
            "args": ["web"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "adk run travel_adviser",
            "type": "debugpy",
            "request": "launch",
            "module": "google.adk.cli",
            "args": ["run", "travel_adviser"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "streamlit run",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": ["run", "streamlit_app.py"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "pytest: current file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["${file}", "-v"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
