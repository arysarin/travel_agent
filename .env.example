# Google AI Studio API key (Gemini) — https://aistudio.google.com
GOOGLE_API_KEY=your_google_ai_studio_key_here

# SerpAPI key — https://serpapi.com (Google Flights + Google Hotels engines)
SERPAPI_API_KEY=your_serpapi_key_here

# OpenWeatherMap API key — https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweathermap_key_here

# Gemini model used by every agent
TRAVEL_ADVISER_MODEL=gemini-3.6-flash

# --- Model fallback chain (all optional, tried in this order) ---
# Every agent falls back through whichever of these are configured
# whenever the current one returns a quota-exhausted (429) or
# overloaded (503) error. See travel_adviser/model_provider.py.

# A second Gemini model under the SAME Google API key above. Free-tier
# quota is tracked per model name, so this is a separate 20/day bucket at
# no extra signup cost. Blank to disable.
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter's free (":free"-suffixed) models — https://openrouter.ai/keys
# Genuinely free, no card required, but the free lineup rotates over
# time — check https://openrouter.ai/models?max_price=0 if it 404s.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731:free

# --- Amadeus: self-serve backup to SerpAPI for flight search ---
# https://developers.amadeus.com (SerpAPI's free tier is only 100
# searches/month). Both keys required together, or leave both blank.
AMADEUS_API_KEY=
AMADEUS_API_SECRET=

# Safety caps (non-functional requirements)
MAX_LLM_CALLS=20
MAX_BUDGET_ROUNDS=3
API_TIMEOUT_SECONDS=10

# Where JSONL invocation logs are written
TRAVEL_ADVISER_LOG_PATH=logs/travel_adviser.jsonl
